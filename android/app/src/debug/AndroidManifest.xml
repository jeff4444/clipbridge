<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets tests trigger a real copy from an app other than the shell helper. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".TestCopyActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".TestWirelessActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <provider
            android:name=".TestProvider"
            android:authorities="dev.clipbridge.test"
            android:exported="false"
            android:grantUriPermissions="true" />
        <receiver
            android:name=".TestWirelessReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.clipbridge.PAIR" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talk to the local adb daemon (127.0.0.1) and the helper's status port. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Discover Android's adb pairing/connect services over mDNS during setup. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Notification with an inline reply, so the pairing code is entered without leaving Settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Bring the helper back after a reboot, without the user opening the app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Serves images/files copied on the Mac to whichever app you paste into.
            Exported because the clip is placed on the clipboard by the shell-user helper, which
            cannot hand out per-app URI grants for this provider. URIs carry a random 64-bit id,
            and only the shell user may write.
        -->
        <activity
            android:name=".SetupActivity"
            android:exported="false" />

        <activity
            android:name=".NoticesActivity"
            android:exported="false"
            android:label="Open-source licences" />

        <service
            android:name=".PairingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".WatchdogJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".PairReplyReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".ClipProvider"
            android:authorities="dev.clipbridge.clips"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>
</manifest>

# Copy to .env (which is never committed) and fill in. Read by release.sh; see "Releasing" in the README.
# The Developer ID certificate, with its private key, must be in this Mac's keychain.
SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
# The certificate's SHA-1 fingerprint, from: security find-identity -v -p codesigning
SIGNING_CERTIFICATE_ID=
# A profile saved once with: xcrun notarytool store-credentials <name>
NOTARY_PROFILE=
